<!-- Add inside <application> in app/src/main/AndroidManifest.xml -->
<!-- Also add: <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> (already present in Hermes) -->
<service
    android:name=".UsbTetherTileService"
    android:exported="true"
    android:icon="@drawable/ic_usb_tether"
    android:label="@string/tile_usb_tether"
    android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
    <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
    </intent-filter>
</service>
